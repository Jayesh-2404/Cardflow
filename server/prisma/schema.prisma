generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  columns      Column[]
  tasks        Task[]
  sessions     Session[]
}

/*
  One row per signed-in device.

  This used to be a single `refreshTokenHash` column on User, which allowed
  exactly one live session: logging in on a second browser overwrote the hash
  and silently logged the first one out. Each browser now gets its own row, so
  sessions coexist and only the row being used is rotated.
*/
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Column {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]

  @@index([userId, position])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  priority    String    @default("medium")
  dueDate     DateTime?
  tags        String[]
  archived    Boolean   @default(false)
  position    Int       @default(0)
  projectKey  String    @default("")
  agentState  String    @default("idle")
  gitEnabled  Boolean   @default(false)
  branch      String?
  lastCommit  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, columnId, position])
  @@index([userId, dueDate])
}

/*
  Append-only journal. Deliberately has no foreign key to Task: a journal that
  loses its history when you archive or delete a card is useless, so entries
  keep a denormalised taskTitle snapshot and survive the task row.
*/
model TaskEvent {
  id         String   @id @default(cuid())
  userId     String
  taskId     String
  taskTitle  String
  type       String
  summary    String
  detail     String?
  fromColumn String?
  toColumn   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
}
