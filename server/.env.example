# Pooled Neon URL (runtime). Get it from Neon dashboard → Connection Details → Pooled.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/kanban?sslmode=require"
# Direct (non-pooled) Neon URL — used only for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/kanban?sslmode=require"
# 32+ random chars. Generate: openssl rand -base64 32. Server-side only, never in frontend.
JWT_SECRET="CHANGE-ME-min-32-chars"
# Frontend origin for CORS + cookie scope. Dev default below; prod = your board URL.
FRONTEND_ORIGIN="http://localhost:5173"
PORT="4000"
NODE_ENV="development"
# MCP (local stdio): one of these. TOKEN preferred; USER_ID for single-user local use.
# KANBAN_TOKEN="jwt-from-login"
# KANBAN_USER_ID="cuid-of-your-user"
# Project roots: copy project-roots.example.json -> project-roots.json and fill real paths.
