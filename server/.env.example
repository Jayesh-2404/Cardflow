# ---------------------------------------------------------------------------
# kanban-server environment. Copy to .env (gitignored) and fill in.
# Deploy walkthrough: docs/DEPLOY.md. Validate before deploying: npm run preflight
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Runtime queries use the pooled URL. Neon dashboard -> Connection Details -> Pooled.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/kanban?sslmode=require"
# Migrations use the direct (non-pooled) URL; a pooler cannot run their DDL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/kanban?sslmode=require"

# --- Auth ------------------------------------------------------------------
# 32+ random chars, server-side only, never in the frontend. Rotating it signs
# every device out. Generate: openssl rand -base64 32
# Without openssl:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="CHANGE-ME-min-32-chars"

# --- HTTP ------------------------------------------------------------------
# Dev default below. Production: the exact deployed web URL — scheme + host,
# https, no trailing slash, e.g. https://your-board.vercel.app. The server
# refuses to boot in production without it (CORS + Secure cookies depend on it).
FRONTEND_ORIGIN="http://localhost:5173"
# Render/Railway inject PORT; 4000 is the local default.
PORT="4000"

# --- Mode -------------------------------------------------------------------
# "production" on the API host. It switches auth cookies to SameSite=None;
# Secure and tightens the boot-time config checks. Keep development locally.
NODE_ENV="development"

# --- MCP (local stdio only) -------------------------------------------------
# Static auth for /api/mcp. The MCP presents the token; the API acts as the
# user id below. Both are required for any MCP tool, and both live only here.
# Generate the token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The id is the cuid of the board owner (already in KANBAN_USER_ID if you used
# the old setup). Replace the old KANBAN_TOKEN/KANBAN_USER_ID pair with these.
KANBAN_MCP_TOKEN="CHANGE-ME-min-32-chars"
KANBAN_MCP_USER_ID="cuid-of-your-user"
# API the MCP talks to. Default http://localhost:4000.
# KANBAN_API_URL="http://localhost:4000"
# Timezone that "today" is resolved in, for list_today. Default Asia/Kolkata.
# KANBAN_TZ="Asia/Kolkata"
# Project roots: copy project-roots.example.json -> project-roots.json and fill real paths.
