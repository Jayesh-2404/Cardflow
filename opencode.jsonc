{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "kanban": {
        "type": "local",
        // The MCP is a thin HTTP client: it starts in well under a second and
        // talks to the API at http://localhost:4000/api/mcp. It holds no
        // Prisma client, so OpenCode's connect timeout is no longer in play.
        // Requires KANBAN_MCP_TOKEN + KANBAN_MCP_USER_ID in server/.env and a
        // running API. After editing server/src, rebuild with:
        //   cd server && node node_modules\typescript\bin\tsc -p tsconfig.json
        // (plain `npm run build` also runs prisma generate, which fails with
        // EPERM on Windows while a running API holds the engine file.)
        "command": ["node", "server/dist/mcp.js"],
        // Native kanban_* tools, not the Code Mode tools.kanban.* wrapper.
        "codemode": false,
        "timeout": 20000
      }
    }
  },
  // OpenCode v2 permissions. Rules are ordered and the LAST match wins, so the
  // broad allow comes first and every narrow deny after it. server/.env holds
  // DATABASE_URL and JWT_SECRET, so it stays unreadable.
  //
  // The shell denies are a guard, not a proof: a determined command can still
  // spell a merge another way. Enable branch protection on main for the real
  // guarantee. The agent may push kanban/* branches so it can open draft PRs.
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git pull*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "git push * main*", "effect": "deny" },
    { "action": "shell", "resource": "git push * master*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "kanban_prune_journal", "resource": "*", "effect": "deny" },
    { "action": "kanban_delete_note", "resource": "*", "effect": "deny" }
  ]
}
